# Ortam: "preview" (varsayılan) iken site arama motorlarına kapalıdır (robots Disallow: /, noindex).
# Canlıya çıkarken "production" yapılır. Bu değişken gizli değildir (tarayıcıya gömülür).
NEXT_PUBLIC_SITE_ENV=preview

# Onay etiketleri: "true" (varsayılan) iken [ONAY BEKLİYOR] etiketleri görünür, "false" iken gizlenir.
# Etiketler gizlense de onaysız SSS'ler FAQPage JSON-LD'ye girmez.
NEXT_PUBLIC_SHOW_PENDING=true
